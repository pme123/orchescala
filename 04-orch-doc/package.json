{
  "name": "orch-doc",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "site": "node tools/assemble.ts ${ORCH_DOCS:-../../00-docs} --old-releases --serve",
    "sample": "node tools/assemble.ts ${ORCH_DOCS:-../../00-docs} --out sample-data/site --no-build",
    "build:spec": "cd ../04-orch-spec && (test -x node_modules/.bin/vite || npm ci) && npx --no-install vite build --base=./ --outDir ../04-orch-doc/dist/spec --emptyOutDir",
    "build:ops": "cd ../04-orch-ops && (test -x node_modules/.bin/vite || npm ci) && npx --no-install vite build --base=./ --outDir ../04-orch-doc/dist/ops --emptyOutDir",
    "build:all": "npm run build && npm run build:spec && npm run build:ops",
    "build:single": "tsc --noEmit && vite build -c vite.single.config.ts",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=dist-tests --out-extension:.js=.mjs --packages=external --loader:.css=empty --loader:.png=empty --log-level=warning && node --test \"dist-tests/*.test.mjs\""
  },
  "dependencies": {
    "bpmn-js": "^18.33.0",
    "dmn-js": "^18.0.3",
    "lucide-react": "^1.74.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
