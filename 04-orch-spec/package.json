{
  "name": "orch-spec",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite --port=3002",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=dist-tests --out-extension:.js=.mjs --packages=external --log-level=warning && node --test \"dist-tests/*.test.mjs\"",
    "check:core": "node tests/checkCore.ts",
    "build:core": "esbuild src/core/index.ts --bundle --format=esm --platform=node --outfile=../06-orch-studio/core/orch-spec-core.mjs --log-level=warning",
    "build:standalone": "vite build --base=./ --outDir dist-standalone --emptyOutDir --logLevel warn",
    "test:standalone": "tsc --noEmit -p e2e && npm run build:standalone && playwright test",
    "build:tools": "esbuild tools/openapi2catalog.ts tools/domain2catalog.ts tools/site2catalog.ts tools/spec2export.ts tools/spec2diff.ts tools/xmlformat.ts --bundle --platform=node --format=esm --outdir=dist-tools --log-level=warning",
    "dev:pages": "vite -c vite.pages.config.ts --port=3013",
    "build:pages": "vite build -c vite.pages.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@azure/msal-browser": "^5.29.1",
    "bpmn-js": "^18.31.1",
    "camunda-bpmn-moddle": "^7.0.2",
    "camunda-dmn-moddle": "^1.3.1",
    "dmn-js": "^17.13.0",
    "feelin": "^8.2.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.546.0",
    "marked": "^18.2.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zeebe-bpmn-moddle": "1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "linkedom": "^0.18.15",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.2",
    "vite": "^8.3.8"
  }
}
